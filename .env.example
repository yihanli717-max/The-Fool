# Server port for the Socket.IO and health-check server.
PORT=3001

# Browser client origins accepted by the server. Separate multiple origins with commas.
CLIENT_ORIGIN=http://localhost:5173

# Optional. When omitted, the server uses local fallback scenarios and prompts.
OPENAI_API_KEY=

# Low-latency model with Structured Outputs support.
OPENAI_MODEL=gpt-5.4-mini

# Optional browser-side override for a remotely hosted Socket.IO server.
# VITE_SERVER_URL=http://localhost:3001
